POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=local_user
POSTGRES_DB=local_db
POSTGRES_PASSWORD=local_password
DATABASE_URL=postgres://local_user:local_password@localhost:5432/local_db

# Stripe test-mode keys — replace with your own test-mode values locally.
# Never put live/production keys in this file (it is version-controlled).
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_test_placeholder
STRIPE_HOSTING_FEE_PRICE_ID=price_test_placeholder

APP_BASE_URL=http://localhost:3000

# Credencial do sysadmin, recriada/sincronizada no banco a cada `npm run dev`
# (ver infra/scripts/seed-admin.js). Mudou aqui? Na próxima subida o e-mail
# e/ou a senha do admin no banco são atualizados para bater com isto.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-password-change-me
