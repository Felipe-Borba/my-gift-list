{
  "name": "gift-list-suggestions",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma para criar e compartilhar listas de sugestão de presentes a partir de links de marketplace.",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && npm run admin:seed && next dev",
    "test": "npm run services:up && npm run services:wait:database && concurrently -n next,jest --hide next --kill-others --success command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "admin:seed": "node --env-file=.env.development infra/scripts/seed-admin.js",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint . --max-warnings 0",
    "prepare": "husky",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cheerio": "1.2.0",
    "cookie": "2.0.1",
    "dotenv": "17.4.2",
    "next": "16.2.10",
    "node-pg-migrate": "8.0.4",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "22.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/css": "1.4.0",
    "@eslint/js": "9.39.4",
    "@eslint/json": "2.0.1",
    "@eslint/markdown": "8.0.3",
    "@faker-js/faker": "10.5.0",
    "@tailwindcss/postcss": "4.3.2",
    "commitizen": "4.3.2",
    "concurrently": "10.0.3",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.15.4",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "prettier": "3.9.4",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3"
  }
}
