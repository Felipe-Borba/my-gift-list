{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(npm run dev:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run services:*)",
      "Bash(npm run migrations:*)",
      "Bash(npm install)",
      "Bash(npm ls:*)",
      "Bash(npx jest:*)",
      "Bash(docker compose -f infra/compose.yaml:*)",
      "Bash(curl http://localhost:*)",
      "WebFetch(domain:localhost)"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
